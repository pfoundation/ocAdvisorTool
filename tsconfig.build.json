{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/ocAdvisor.ts",
    "src/typesafeGate.ts",
    "src/typesafeState.ts",
    "src/cli.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/usageReport.ts",
    "src/typesafeGate.eval.ts"
  ]
}
