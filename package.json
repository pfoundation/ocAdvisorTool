{
  "name": "@pfoundation/ocadvisor",
  "version": "26.9.0",
  "description": "OpenCode V2 plugin: consult Claude Fable 5.1 as senior advisor via OpenCode session generation",
  "type": "module",
  "license": "MIT",
  "author": "P Foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/pfoundation/ocAdvisorTool"
  },
  "homepage": "https://github.com/pfoundation/ocAdvisorTool#readme",
  "bugs": {
    "url": "https://github.com/pfoundation/ocAdvisorTool/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "advisor",
    "claude",
    "ai",
    "coding-agent"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun test && bun run typecheck",
    "report": "bun src/usageReport.ts --days 30"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.7.2"
  }
}
